# Copy to `.env` (gitignored) and fill in. Read from this package's root at
# startup, whatever directory the server was spawned from.
#
# Anything already set in the environment wins over this file — including the
# `env` block of an MCP entry in `~/.claude.json` — so a value here is a
# default, not an override. Restart the server to pick up an edit.

# Transit journeys from Transport for NSW's Trip Planner.
#
# Free, 60,000 calls a day: opendata.transport.nsw.gov.au -> register ->
# create an application -> add "Trip Planner APIs" -> copy the key.
#
# Without it `travelMode: "transit"` falls back to Google Routes, which returns
# a duration and no legs — so no product classes, and no way to tell a walk
# from a ferry crossing. That fallback is reported as `router: "google"` in the
# travel report rather than failing, so it is easy to miss.
#TFNSW_API_KEY=

# Which engine answers each travel mode. Two settings, because they are two
# different questions: a road router cannot do public transport and the
# transit planners do not do walking or driving matrices.
#
# Road modes (walk, drive): valhalla (default; no key, a few minutes optimistic
# in the CBD — no traffic-light delay), ors (ORS_API_KEY), google
# (GOOGLE_MAPS_API_KEY; what the committed runs were measured with).
#REALESTATE_MCP_ROUTER=valhalla
#
# Transit: tfnsw (TFNSW_API_KEY; the journey in legs, so a ferry is a measured
# fact) or google (a bare duration). Unset: tfnsw when TFNSW_API_KEY is set,
# google otherwise. Set explicitly and there is no fallback — tfnsw without a
# key refuses rather than quietly measuring with Google.
#REALESTATE_MCP_TRANSIT_ROUTER=tfnsw

# Server key with the Routes API and Geocoding API enabled. Needed for
# REALESTATE_MCP_ROUTER=google, REALESTATE_MCP_GEOCODER=google, and as the
# transit fallback when TFNSW_API_KEY is unset. Never a browser key.
#GOOGLE_MAPS_API_KEY=

# Only read when REALESTATE_MCP_ROUTER=ors.
#ORS_API_KEY=

# Where the routed/geocoded cache lives. Default is ~/.realestate-mcp/, which is
# per-machine and invisible. Point it into a consuming repo to have one cache
# that is committed, diffable and shared between machines. Absolute path, so it
# differs per machine even when the repo does not.
#REALESTATE_MCP_DISTANCE_CACHE=/path/to/SydneyRealEstateFindings/data/knowledge/mcp-cache.json

# The findings repo — the site whose `data/` and `public/` this pipeline writes.
# Default: the sibling checkout, `../SydneyRealEstateFindings`, resolved from this
# package rather than from the working directory. Only needed when the two repos
# are not side by side. It relocates the data, not the code: the scripts import
# the site's `src/lib/schema` from the sibling path regardless.
#FINDINGS_DIR=/path/to/SydneyRealEstateFindings

# Cloudflare R2, where the pipeline publishes listing photos. See README,
# "Photo hosting", for how to create the bucket and token. R2_PUBLIC_BASE_URL
# must match NEXT_PUBLIC_IMAGE_BASE_URL in ../SydneyRealEstateFindings/.env.local
# (and in its Vercel project) — the site builds photo URLs from that one.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=sydney-rental-findings
#R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
