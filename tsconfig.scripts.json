{
  // Type-checks `scripts/` (the pipeline moved in from the findings repo)
  // together with `src/`.
  //
  // A second config rather than a wider `include` in tsconfig.json: that one has
  // `rootDir: src` and Node16 resolution, and the scripts use extensionless
  // relative imports, which the main config rejects — and `prepare` runs it on
  // every `npm install`. This one never emits. `npm run typecheck` is the way in.
  //
  // Nothing here reaches across the repo boundary any more: the site's schema is
  // the `sydney-rental-schema` package (PHASE2.md Step 2). PHASE2.md Step 3 folds
  // the stages into `src/`, after which this covers only the check scripts.
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"]
}
